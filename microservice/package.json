{
  "name": "townpass-life-events",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/clean-dist.mjs && vite build",
    "build:app": "npm run build && node scripts/bundle-app.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
