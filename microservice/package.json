    "deploy:login": "node scripts/deploy.mjs login"
  },
  "dependencies": {
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
